# Portul pe care ruleaza serverul
PORT=3000

# Calea catre fisierul SQLite (default: ./casa.db)
DB_PATH=./casa.db

# Pretul pe noapte in MDL
PRICE_PER_NIGHT=1500

# Cheia secreta pentru endpointurile admin (foloseste o valoare lunga si aleatoare)
ADMIN_KEY=schimba-aceasta-cheie-cu-una-secreta

# =====================================================================
# EMAIL — notificari de rezervare
# =====================================================================
# Email-ul proprietarului (primeste notificarea la fiecare rezervare noua)
NOTIFY_EMAIL=contact@casadinpovesti.md

# URL-ul site-ului (apare in email-uri si in linkurile de admin)
SITE_URL=https://casadinpovesti.md

# Trimite si oaspetelui o confirmare? (true / false)
SEND_GUEST_CONFIRMATION=true

# ----- SMTP -----
# Daca aceste variabile NU sunt setate, email-urile sunt sarite (fara eroare).
#
# Optiuni populare:
#  Gmail:   host=smtp.gmail.com  port=587  user=adresa@gmail.com  pass=APP_PASSWORD
#           (genereaza o "App password" in contul Google, nu parola normala)
#  Resend:  host=smtp.resend.com port=587  user=resend  pass=re_xxx
#  Mailgun: host=smtp.mailgun.org port=587  user=postmaster@... pass=...
#  SendGrid:host=smtp.sendgrid.net port=587  user=apikey  pass=SG.xxx
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Adresa "From" care apare in email-uri (cu nume afisat)
SMTP_FROM="Casa din Povesti <noreply@casadinpovesti.md>"
